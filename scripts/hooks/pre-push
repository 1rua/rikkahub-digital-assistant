#!/usr/bin/env bash
# rikkahub-apk-autodownload
# 推送到 origin 的 master/main 后，后台等待 GitHub Actions 构建，完成后自动下载 APK。
# 由 scripts/install-hooks.sh 安装到 .git/hooks/pre-push，不会阻塞 push 本身。
set -uo pipefail

remote_name="${1:-}"
pushed=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in
    0000000000000000000000000000000000000000) continue ;; # 删除分支，忽略
  esac
  case "$remote_ref" in
    refs/heads/master|refs/heads/main) pushed=1 ;;
  esac
done

[ "$remote_name" = "origin" ] || exit 0
[ "$pushed" = 1 ] || exit 0

root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
fetcher="$root/scripts/fetch-apk.sh"
[ -x "$fetcher" ] || exit 0

log_file="$root/.git/rikkahub-apk-autodownload.log"
nohup "$fetcher" --new --notify >> "$log_file" 2>&1 &
disown 2>/dev/null || true

exit 0
